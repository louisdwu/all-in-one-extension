{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "version": "1.2026.1028.0846",
    "description": "__MSG_extDescription__",
    "default_locale": "zh_CN",
    "permissions": [
        "tabs",
        "storage",
        "alarms",
        "idle",
        "cookies",
        "webNavigation"
    ],
    "host_permissions": [
        "*://*.bilibili.com/*",
        "https://api.waqi.info/*"
    ],
    "optional_host_permissions": [
        "*://*/*"
    ],
    "background": {
        "service_worker": "background/index.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "libs/core.js",
                "libs/keys.js",
                "libs/rules.js",
                "libs/schema.js",
                "content/lib/content.js",
                "content/aio_tabs.js",
                "content/ezincognito.js",
                "content/hotkey_gate.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/hotkey_inject.js"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "world": "MAIN"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "libs/core.js",
                "content/speeder_inject.js"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "world": "MAIN"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "libs/core.js",
                "libs/keys.js",
                "libs/rules.js",
                "libs/schema.js",
                "libs/speed_memory.js",
                "content/lib/content.js",
                "content/speeder.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": [
                "*://*.bilibili.com/video/*",
                "*://*.bilibili.com/bangumi/*",
                "*://*.bilibili.com/list/*"
            ],
            "js": [
                "libs/core.js",
                "libs/schema.js",
                "content/lib/content.js",
                "content/bilibili/guard.js",
                "content/bilibili/ui.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "*://*.bilibili.com/video/*",
                "*://*.bilibili.com/bangumi/*",
                "*://*.bilibili.com/list/*"
            ],
            "js": [
                "libs/core.js",
                "libs/md5.js",
                "libs/wbi.js",
                "content/bilibili/inject.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ],
    "action": {
        "default_popup": "ui/popup.html",
        "default_title": "All in One Extension",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_page": "ui/options.html",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "commands": {
        "toggle-speed": {
            "suggested_key": {
                "default": "Ctrl+Shift+Right",
                "mac": "Command+Shift+Right"
            },
            "description": "提高当前页面视频速度"
        },
        "decrease-speed": {
            "suggested_key": {
                "default": "Ctrl+Shift+Left",
                "mac": "Command+Shift+Left"
            },
            "description": "降低当前页面视频速度"
        },
        "preset-speed": {
            "suggested_key": {
                "default": "Ctrl+Shift+Space",
                "mac": "Command+Shift+Space"
            },
            "description": "切换到预设倍速/正常速度"
        }
    }
}
